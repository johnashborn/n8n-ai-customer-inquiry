    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"nvidia/nemotron-3-ultra-550b-a55b:free\",\n  temperature: 0.2,\n  reasoning: { effort: \"low\" },\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are a customer support assistant. Analyze customer inquiries. Return ONLY valid JSON with these fields: category, urgency, summary, suggested_response. Category must be one of Inquiry, Complaint, Support, or Spam. Urgency must be Low, Medium, or High. Do not invent company policies or claim actions have been completed.\"\n    },\n    {\n      role: \"user\",\n      content: \"Customer name: \" + $json.customer_name + \"\\nCustomer inquiry: \" + $json.inquiry\n    }\n  ]\n}) }}",
        "options": {
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        -100
      ],
      "id": "6493c6e5-edae-4775-b044-2d851907df64",
      "name": "Classify with AI",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Runs once per item, so several emails in one run are all handled\nconst content = $json.choices?.[0]?.message?.content;\n\nif (!content) {\n  throw new Error(\"No AI response received.\");\n}\n\n// Remove ```json fences, then grab the JSON object even if the model added text around it\nconst cleaned = content\n  .replace(/^```json\\s*/i, \"\")\n  .replace(/^```\\s*/i, \"\")\n  .replace(/\\s*```$/, \"\")\n  .trim();\nconst match = cleaned.match(/\\{[\\s\\S]*\\}/);\n\nlet result;\ntry {\n  result = JSON.parse(match ? match[0] : cleaned);\n} catch (e) {\n  throw new Error(\"AI did not return valid JSON: \" + cleaned.slice(0, 200));\n}\n\nconst allowedCategories = [\"Inquiry\", \"Complaint\", \"Support\", \"Spam\"];\nconst allowedUrgencies = [\"Low\", \"Medium\", \"High\"];\n\nif (!allowedCategories.includes(result.category)) {\n  throw new Error(\"Invalid category returned: \" + result.category);\n}\nif (!allowedUrgencies.includes(result.urgency)) {\n  throw new Error(\"Invalid urgency returned: \" + result.urgency);\n}\nif (typeof result.summary !== \"string\" || typeof result.suggested_response !== \"string\") {\n  throw new Error(\"Missing or invalid response fields.\");\n}\n\nreturn {\n  json: {\n    category: result.category,\n    urgency: result.urgency,\n    summary: result.summary,\n    suggested_response: result.suggested_response\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        -100
      ],
